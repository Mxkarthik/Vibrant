PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Google OAuth Callback URL
# Local Development:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production (Render):
# GOOGLE_CALLBACK_URL=https://vibrant-qkl1.onrender.com/api/auth/google/callback

JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Comma-separated exact Frontend origins allowed for CORS and OAuth redirects.
# Local Development:
ADMIN_FRONTEND_URL=http://localhost:5173
PARTICIPANT_FRONTEND_URL=http://localhost:5174
# Production (Set to your actual deployed frontend URLs):
# PARTICIPANT_FRONTEND_URL=https://vibrant-orcin.vercel.app
# ADMIN_FRONTEND_URL=https://<your-admin-frontend>.vercel.app

# Cross-Site Cookie Setting:
# Use 'lax' for local development.
# Use 'none' in production when frontend (Vercel) and backend (Render) are on different domains.
AUTH_COOKIE_SAME_SITE=lax
# In production on Render:
# AUTH_COOKIE_SAME_SITE=none

# Optional. Set only when frontend and API share a parent cookie domain.
# AUTH_COOKIE_DOMAIN=.example.edu
