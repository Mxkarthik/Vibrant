PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Comma-separated exact frontend origins allowed to make credentialed API requests.
ADMIN_FRONTEND_URL=http://localhost:5173

# Use lax for localhost or same-site deployments. Use none only for truly cross-site
# frontend/API hosts; this requires HTTPS, and Secure will be enabled automatically.
AUTH_COOKIE_SAME_SITE=lax
# Optional. Set only when frontend and API must share a parent cookie domain.
# AUTH_COOKIE_DOMAIN=.example.edu
